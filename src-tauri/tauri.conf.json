{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plant Health Tracker",
  "version": "0.3.0",
  "identifier": "com.ameya.plant-health-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plant Health Tracker",
        "width": 380,
        "height": 560,
        "minWidth": 340,
        "minHeight": 275,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "visible": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQzY4RTJDMjRFNDQ2RTUKUldUbFJ1UWtMSTdHeklVWG5mNllybGd0YWVlNDNJdmQyeG9HTmlNVjVrTHFZOEd3WUZsZnhEaFgK",
      "endpoints": [
        "https://github.com/ameyasurya/plant-health-tracker/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
